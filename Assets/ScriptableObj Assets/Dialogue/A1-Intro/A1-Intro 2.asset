      isTalking: 0
    backgroundMode: 0
    vignetteIntensity: 0
    backgroundFadeDuration: 0
    sentence: Ako po si Tala, isang babaylan. Hinatid po ako rito ni Diwata Amihan.
  - isFourSpeakers: 0
