      isTalking: 0
    backgroundMode: 0
    vignetteIntensity: 0
    backgroundFadeDuration: 0
    sentence: Mga kawal! Bantayan ninyo ang mga tarangkahan. Kayo naman, suriin ang
      hilagang daan!
  - isFourSpeakers: 0
