    rightSecondaryProfile:
      sprite: {fileID: 21300000, guid: 856dc61fd54fe4c14b56f243c66efb4f, type: 3}
      isTalking: 0
    sentence: Hindi, anak. Mananatili kami rito. Mula sa aming tahanan, mababantayan
      namin ang mga diwa at ang aming mga inapo.
  - isFourSpeakers: 1
    leftPrimaryProfile:
      sprite: {fileID: 21300000, guid: 769979fd4ad5d4b3296a088d4aa90d44, type: 3}
