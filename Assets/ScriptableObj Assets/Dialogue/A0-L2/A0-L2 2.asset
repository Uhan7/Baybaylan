    rightSecondaryProfile:
      sprite: {fileID: 21300000, guid: 856dc61fd54fe4c14b56f243c66efb4f, type: 3}
      isTalking: 0
    sentence: Kung gayon, sumama po kayo sa akin.
  - isFourSpeakers: 1
    leftPrimaryProfile:
      sprite: {fileID: 21300000, guid: 769979fd4ad5d4b3296a088d4aa90d44, type: 3}
