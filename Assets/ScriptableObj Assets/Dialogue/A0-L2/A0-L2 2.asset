    rightSecondaryProfile:
      sprite: {fileID: 21300000, guid: 856dc61fd54fe4c14b56f243c66efb4f, type: 3}
      isTalking: 1
    sentence: Ikaw ang kailangang sumunod sa tawag. Huwag kang mag-alala, hindi ka
      namin pababayaan.
  - isFourSpeakers: 1
    leftPrimaryProfile:
