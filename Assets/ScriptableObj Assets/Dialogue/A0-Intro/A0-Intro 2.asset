  m_Script: {fileID: 11500000, guid: c04b1f020ba8f49729190e402fd98d39, type: 3}
  m_Name: A0-Intro 2
  m_EditorClassIdentifier: 
  sentences:
  - speakerPosition: 1
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 0}
    sentence: <i>Dito ba ninyo ako dinadala?</i>
  - speakerPosition: 1
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 0}
    sentence: <i>Hmm...</i> Ah!
  - speakerPosition: 2
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 4bba5c128555e42e1971993356d20c5b, type: 3}
    sentence: Anak! Sa wakas, narinig mo rin ako.
  - speakerPosition: 1
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 4bba5c128555e42e1971993356d20c5b, type: 3}
    sentence: Kayo po ang tumatawag sa akin?
  - speakerPosition: 2
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 4bba5c128555e42e1971993356d20c5b, type: 3}
    sentence: Ako si Amihan. May nais akong ipakita sa iyo.
  - speakerPosition: 1
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 4bba5c128555e42e1971993356d20c5b, type: 3}
    sentence: Ako po si Tala, ikinagagalak ko po kayong makilala, Diwata Amihan.
      Ano naman po ang problema?
  - speakerPosition: 2
    leftCharacterSprite: {fileID: 21300000, guid: 3d100fcf41a4a4478a2e9d91db1ca357, type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 4bba5c128555e42e1971993356d20c5b, type: 3}
    sentence: Halika rito, anak. Sumunod ka sa akin.
  soundToPlay: {fileID: 0}
  textSpeed: 0.022
  textPunctSpeed: 0.24
