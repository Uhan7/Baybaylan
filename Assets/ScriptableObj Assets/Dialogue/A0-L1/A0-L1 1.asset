    rightSecondaryProfile:
      sprite: {fileID: 0}
      isTalking: 0
    sentence: Narito na tayo, Tala.
  - isFourSpeakers: 0
    leftPrimaryProfile:
      sprite: {fileID: 21300000, guid: 769979fd4ad5d4b3296a088d4aa90d44, type: 3}
      isTalking: 1
    leftSecondaryProfile:
      sprite: {fileID: 0}
